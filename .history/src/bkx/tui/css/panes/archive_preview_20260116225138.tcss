/* ArchivePreviewPane styles */

ArchivePreviewPane {
    width: 1fr;
    dock: right;
    background: $surface;
    border: solid $secondary;
}

.preview-header {
    height: 3;
    background: $primary;
    color: $foreground;
    content-align: center middle;
}

.preview-content {
    height: 1fr;
    dock: bottom;
    padding: 1;
}


.preview-placeholder {
    color: $foreground-muted;
    content-align: center middle;
    text-style: italic;
}


.meta-label {
    color: $foreground-muted;
    width: 15;
    text-align: right;
    margin-right: 1;
}

.meta-value {
    color: $foreground;
    width: 1fr;
}

.meta-row {
    height: 2;
    width: 1fr;
}

