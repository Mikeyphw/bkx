/* EmptyStatePane styles */

EmptyStatePane {
    width: 60;
    height: 20;
    dock: center;
    background: $surface;
    border: dashed $foreground-muted;
}

.empty-icon {
    height: 6;
    font-size: 3;
    content-align: center middle;
}

.empty-title {
    height: 3;
    color: $foreground;
    font-size: 1.5;
    font-weight: bold;
    content-align: center middle;
}

.empty-message {
    height: auto;
    color: $foreground-muted;
    content-align: center middle;
    max-width: 50;
}

.empty-action {
    height: 5;
    dock: bottom;
    align: center middle;
}

