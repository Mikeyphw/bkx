/* RunLogPane styles */

RunLogPane {
    height: 15;
    dock: bottom;
    background: $surface;
    border: solid $secondary;
}

.log-header {
    height: 2;
    dock: top;
    background: $surface-darken-1;
}

.log-title {
    color: $foreground;
    font-weight: bold;
    padding: 0 1;
}

.log-controls {
    height: 2;
    dock: top;
    background: $surface-darken-1;
}

.log-controls Button {
    margin: 0 1;
    min-width: 8;
}

RichLog {
    height: 1fr;
    dock: bottom;
}

