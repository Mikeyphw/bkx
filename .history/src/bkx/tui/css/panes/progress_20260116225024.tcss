/* ProgressPane styles (mikomn available) */

ProgressPane {
    height: 8;
    dock: bottom;
    background: $surface;
    border: solid $primary;
}

.progress-header {
    height: 2;
    background: $surface-darken-1;
}


.progress-operation {
    color: $foreground;
    text-style: bold;
}


.progress-message {
    color: $foreground-muted;
}

.progress-bar-container {
    height: 3;
    background: $surface-darken-2;
    dock: top;
}

.progress-bar-fill {
    height: 100%;
    background: $success;
    width: 0%;
}

.progress-bar-fill.error {
    background: $error;
}

.progress-stats {
    height: 2;
    dock: bottom;
    color: $foreground-muted;
}

.progress-percentage {
    width: 15;
    text-align: right;
}

.progress-details {
    width: 1fr;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.progress-active {
    animation: pulse 1s infinite;
}

