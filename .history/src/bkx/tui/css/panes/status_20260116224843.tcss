/* StatusFooterPane styles */

StatusFooterPane {
    height: 2;
    dock: bottom;
    background: $surface;
    color: $foreground-muted;
}

.status-section {
    width: 1fr;
    padding: 0 1;
    align: center middle;
}

.status-left {
    align: left middle;
}

.status-center {
    align: center middle;
}

.status-right {
    align: right middle;
}

.status-indicator {
    color: $success;
}

.status-indicator.busy {
    color: $warning;
    animation: blink 1s infinite;
}


.key-hint {
    color: $accent;
    text-style: bold;
}


.key-separator {
    color: $foreground-muted;
    margin: 0 0.5;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

