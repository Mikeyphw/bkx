/* ThemeSettingsPane styles */

ThemeSettingsPane {
    background: $background;
}

.settings-header {
    height: 3;
    dock: top;
    background: $primary;
    color: $foreground;
    content-align: center middle;
}

.settings-grid {
    width: 60;
    height: auto;
    align: center middle;
    background: $surface;
    border: solid $secondary;
    padding: 2;
    margin: 1;
}

.setting-row {
    height: 4;
    width: 1fr;
    margin-bottom: 1;
}

.setting-label {
    color: $foreground;
    width: 25;
    text-align: right;
    margin-right: 1;
}

.setting-value {
    color: $accent;
    width: 1fr;
    font-weight: bold;
}

.theme-preview {
    height: 8;
    width: 30;
    dock: right;
    background: $surface-darken-1;
    border: solid $secondary;
    margin: 1;
}

