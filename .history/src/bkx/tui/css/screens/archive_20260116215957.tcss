/* ArchiveScreen styles */

ArchiveScreen {
    background: $background;
}

.screen-header {
    height: 3;
    dock: top;
    background: $primary;
    content-align: center middle;
}

.form-container {
    width: 60;
    height: auto;
    dock: center;
    background: $surface;
    border: solid $secondary;
    padding: 1;
    margin: 1;
}

.form-row {
    height: auto;
    width: 1fr;
    margin-bottom: 1;
}

.form-label {
    color: $foreground;
    width: 20;
    text-align: right;
    margin-right: 1;
}

.button-row {
    height: 3;
    dock: bottom;
    align: center middle;
}

.button-row Button {
    margin: 0 1;
    min-width: 15;
}

/* Browser layout */
.browser-container {
    width: 1fr;
    height: 1fr;
    dock: center;
}

.browser-toolbar {
    height: 3;
    dock: top;
    background: $surface-darken-1;
    align: left middle;
}

.browser-toolbar Input {
    width: 40;
    margin: 0 1;
}

.browser-content {
    width: 1fr;
    height: 1fr;
    dock: bottom;
}

.archive-list-pane {
    width: 45;
    dock: left;
}

.archive-preview-pane {
    width: 1fr;
    dock: right;
}

.browser-status {
    height: 2;
    dock: bottom;
    background: $surface-darken-1;
    color: $foreground-muted;
    content-align: center middle;
}

