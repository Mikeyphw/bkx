/* ToolsScreen styles */

ToolsScreen {
    background: $background;
}

.screen-header {
    height: 3;
    dock: top;
    background: $primary;
    content-align: center middle;
}

.tools-grid {
    width: 60;
    height: auto;
    dock: center;
    background: $surface;
    border: solid $secondary;
    padding: 2;
    margin: 1;
}

.tool-button {
    width: 25;
    height: 5;
    margin: 1;
}

.tool-icon {
    font-size: 2;
    text-align: center;
}

.tool-name {
    text-align: center;
    font-weight: bold;
}

.tool-desc {
    text-align: center;
    color: $foreground-muted;
    font-size: small;
}

