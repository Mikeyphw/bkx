      Android Lint cannot see string-by-name resource lookups, so keep the exact
      resources for optimized resource shrinking and suppress only this known
      false-positive UnusedResources diagnostic on each reflective label.
    -->
    <string name="tasker_event_type" tools:ignore="UnusedResources">Event</string>
    <string name="tasker_state_type" tools:ignore="UnusedResources">State</string>
    <string name="tasker_filter_operation" tools:ignore="UnusedResources">Operation filter</string>
