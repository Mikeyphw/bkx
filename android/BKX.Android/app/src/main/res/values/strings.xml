    <string name="tasker_filter_request_id" tools:ignore="UnusedResources">Request ID pattern</string>
    <string name="tasker_filter_error_code" tools:ignore="UnusedResources">Error code filter</string>
    <string name="tasker_filter_job_id" tools:ignore="UnusedResources">Saved job ID</string>
    <string name="tasker_filter_repository_id" tools:ignore="UnusedResources">Repository ID</string>
    <string name="tasker_filter_snapshot_id" tools:ignore="UnusedResources">Snapshot ID</string>
    <string name="tasker_progress_cadence" tools:ignore="UnusedResources">Progress cadence</string>
</resources>
