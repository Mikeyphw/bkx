+
+    # =========================================================================
+    # Global intents (message-driven overlays + actions)
+    # =========================================================================
+
+    def _handle_show_command_palette(self, intent: ShowCommandPalette) -> None:
+        """Open the command palette (optionally prefilled)."""
+        try:
+            from mikomn.tui_base.overlays.command_palette import CommandPalette
+
+            palette = CommandPalette(commands=self.build_command_palette_commands())
+            if getattr(intent, "query", None):
+                q = str(intent.query)
+                # Best-effort; different mikomn builds may expose different APIs.
+                try:
+                    palette.set_query(q)  # type: ignore[attr-defined]
+                except Exception:
+                    try:
+                        setattr(palette, "query", q)
+                    except Exception:
+                        pass
+            self.push_screen(palette)
+        except Exception:
+            try:
+                self.action_command_palette()
+            except Exception:
+                self.notify("Command palette unavailable", severity="warning")
+
+    def _handle_show_notification_center(self, intent: ShowNotificationCenter) -> None:
+        """Open the notification center screen."""
+        try:
+            self.action_notification_center()
+        except Exception:
+            self.notify("Notification center unavailable", severity="warning")
+
+    def _handle_cycle_theme(self, intent: CycleTheme) -> None:
+        """Cycle theme (message-driven)."""
+        try:
+            self.action_cycle_theme()
+        except Exception:
+            try:
+                self._theme_name = self.cycle_theme_local()
+                self._on_theme_changed(self._theme_name)
+            except Exception:
+                self.notify("Theme cycle failed", severity="warning")
+
+    def _handle_reload_css(self, intent: ReloadCss) -> None:
+        """Reload TCSS (message-driven)."""
+        try:
+            from bkx.tui.css import reload_bkx_css
+
+            reload_bkx_css(self)
+            self.notify("CSS reloaded", severity="info")
+        except Exception:
+            self.notify("CSS reload failed", severity="warning")
+
+    def _handle_clear_logs(self, intent: ClearLogs) -> None:
+        """Clear logs (message-driven)."""
+        self._clear_all_logs()
+        self.notify("Logs cleared", severity="info")
