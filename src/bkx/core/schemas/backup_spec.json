{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BackupSpec",
  "description": "Normalized specification for a backup operation.",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source paths to back up"
    },
    "destination": {
      "type": "string",
      "nullable": true,
      "description": "Destination path for archive storage"
    },
    "archive_name": {
      "type": "string",
      "nullable": true,
      "description": "Explicit archive name (auto-generated if not set)"
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Glob patterns to exclude"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Glob patterns to include"
    },
    "split_size": {
      "type": "integer",
      "nullable": true,
      "description": "Chunk size for split archives (bytes)"
    },
    "compression": {
      "type": "object",
      "required": ["algorithm"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["zstd", "gzip", "lz4", "xz", "bzip2", "none"],
          "description": "Compression algorithm"
        },
        "level": {
          "type": "integer",
          "description": "Compression level"
        }
      }
    },
    "verify": {
      "type": "boolean",
      "default": true,
      "description": "Verify archive after creation"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Just show plan, don't execute"
    },
    "_resolved_destination": {
      "type": "string",
      "nullable": true,
      "description": "Internal: resolved destination path"
    },
    "_archive_path": {
      "type": "string",
      "nullable": true,
      "description": "Internal: full archive path"
    }
  }
}

