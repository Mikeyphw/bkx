{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bkx.local/schemas/restore-spec.json",
  "title": "RestoreSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archive",
    "destination",
    "paths",
    "overwrite",
    "verify",
    "dry_run",
    "fresh_dir",
    "confirm_overwrite"
  ],
  "properties": {
    "archive": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*\u0000).+$"
    },
    "destination": {
      "type": [
        "string",
        "null"
      ]
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\u0000)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))\\S(?:.*\\S)?/?$"
      },
      "default": []
    },
    "overwrite": {
      "type": "boolean",
      "default": false
    },
    "verify": {
      "type": "boolean",
      "default": true
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "fresh_dir": {
      "type": "boolean",
      "default": true
    },
    "confirm_overwrite": {
      "type": "boolean",
      "default": true
    }
  }
}
