{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bkx.local/schemas/transfer-spec.json",
  "title": "TransferSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources",
    "destination",
    "direction",
    "verify",
    "checksum",
    "dry_run",
    "overwrite"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=.*\\S)(?!.*\u0000).+$"
      }
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*\u0000).+$"
    },
    "direction": {
      "type": "string",
      "enum": [
        "push",
        "pull"
      ]
    },
    "verify": {
      "type": "boolean",
      "default": true
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*\u0000).+$"
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "overwrite": {
      "type": "boolean",
      "default": false
    }
  }
}
