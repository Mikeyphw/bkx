/* bkx/src/bkx/tui/css/accessibility.tcss Accessibility improvements
   Color contrast compliance and focus management.
*/

/* ==========================================================================
   Color Contrast (WCAG AA Compliant)
   ========================================================================== */

/* Primary colors - dark backgrounds */
/* Variables available for use in TCSS-compatible properties */

/* Status colors with better contrast */
/* Variables available for use in TCSS-compatible properties */

/* Focus colors */
/* Variables available for use in TCSS-compatible properties */

/* ==========================================================================
   Focus Management
   ========================================================================== */

/* Default focus style - visible ring */
*:focus {
    outline: solid $accent;
}

/* Focus within widgets */
Widget:focus {
    outline: solid $accent;
}

/* Button focus */
Button:focus {
    outline: solid $accent;
}

/* Input focus */
Input:focus {
    outline: solid $accent;
    background: $surface-lighten-1;
}

/* List item focus */
ListItem:focus {
    outline: solid $accent;
}

/* Tab focus */
Tab:focus {
    outline: solid $accent;
}

/* ==========================================================================
   High Contrast Mode
   ========================================================================== */

.high-contrast {
    /* Force high contrast colors */
    background: #000000;
    color: #ffffff;
}

.high-contrast Button,
.high-contrast Input {
    border: solid #ffffff;
}

/* ==========================================================================
   Large Text Mode
   ========================================================================== */

.large-text {
    /* Large text mode - styling handled by app logic */
}

/* ==========================================================================
   Screen Reader Support (aria equivalents)
   ========================================================================== */

/* Visually hidden but accessible to screen readers */
.bkx-sr-only {
    /* Screen reader only class - hidden from view */
}

/* Announce to screen readers */
.bkx-announce {
    /* Screen reader announcements */
}

/* ==========================================================================
   Keyboard Navigation Indicators
   ========================================================================== */

/* Show keyboard navigation mode */
.bkx-keyboard-nav *:focus {
    outline: solid $accent;
}

/* Mouse navigation - hide focus except on keyboard use */
.bkx-mouse-nav *:focus {
    outline: none;
}

/* ==========================================================================
   Error & Warning States
   ========================================================================== */

/* Error state with good contrast */
.bkx-error {
    color: $error;
    background: $error-background;
}

.bkx-error:focus {
    outline: solid $error;
}

/* Warning state with good contrast */
.bkx-warning {
    color: $warning;
    background: $warning-background;
}

.bkx-warning:focus {
    outline: solid $warning;
}

/* Success state */
.bkx-success {
    color: $success;
    background: $success-background;
}

/* ==========================================================================
   Disabled State
   ========================================================================== */

.bkx-disabled {
    opacity: 0.5;
    text-style: dim;
}

.bkx-disabled:focus {
    outline: none;
}

/* ==========================================================================
   Required Field Indicator
   ========================================================================== */

/* Required field indicator handled by app logic */

/* ==========================================================================
   Form Validation Styles
   ========================================================================== */

.bkx-invalid {
    border: solid $error;
}

.bkx-invalid:focus {
    outline: solid $error;
}

.bkx-validation-message {
    color: $error;
}

/* ==========================================================================
   Loading State
   ========================================================================== */

.bkx-loading {
    /* Loading cursor handled by app logic */
}

.bkx-loading * {
    /* Loading cursor handled by app logic */
}

/* ==========================================================================
   Reduced Motion
   ========================================================================== */

