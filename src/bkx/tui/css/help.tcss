/* bkx/src/bkx/tui/css/help.tcss Help Overlay Styling
*/

/* ==========================================================================
   Help Overlay
   ========================================================================== */

.bkx-help-overlay {
    width: 80%;
    height: 80%;
    border: solid $accent;
    background: $surface;
}

.bkx-help-overlay .help-section-title {
    margin: 1 0;
}

.bkx-help-overlay .help-category {
    margin: 1 0 0 0;
}

.bkx-help-overlay .help-shortcut-row {
    height: auto;
    margin: 0;
}

.bkx-help-overlay .help-key {
    width: 20;
    color: $accent;
}

.bkx-help-overlay .help-description {
    width: 1fr;
    color: $text;
}

.bkx-help-overlay .help-nav-title {
    margin: 1 0 0 0;
    color: $success;
}

.bkx-help-overlay .help-nav-desc {
    color: $text-muted;
    margin-left: 2;
}

.bkx-help-overlay .help-tip-title {
    margin: 1 0 0 0;
}

.bkx-help-overlay .help-tip-desc {
    color: $text-muted;
    margin-left: 2;
}

/* ==========================================================================
   Help Tabs
   ========================================================================== */

.bkx-help-overlay .help-tabs {
    height: auto;
}

.bkx-help-overlay .help-tab {
    padding: 0 2;
}

/* ==========================================================================
   Shortcuts Reference Widget (Standalone)
   ========================================================================== */

.bkx-shortcuts-reference {
    padding: 1;
    border: solid $border;
    background: $surface-darken-1;
}

.bkx-shortcuts-reference .shortcuts-title {
    margin: 0 0 1 0;
}

.bkx-shortcuts-reference .shortcuts-category {
    margin: 1 0 0 0;
    color: $accent;
}

.bkx-shortcuts-reference .shortcuts-row {
    height: auto;
    margin: 0;
}

.bkx-shortcuts-reference .shortcuts-key {
    width: 10;
    color: $text-muted;
}

.bkx-shortcuts-reference .shortcuts-desc {
    color: $text;
}

/* ==========================================================================
   Page Help Widget
   ========================================================================== */

.bkx-page-help {
    padding: 1;
    border: solid $border;
    background: $surface-darken-1;
    height: auto;
}

.bkx-page-help .page-help-title {
    color: $accent;
    margin: 0 0 1 0;
}

.bkx-page-help .page-help-text {
    color: $text-muted;
}

/* ==========================================================================
   Tips Widget
   ========================================================================== */

.bkx-tips-widget {
    padding: 1;
    border: solid $success;
    background: $surface-darken-1;
    height: auto;
}

.bkx-tips-widget .tips-title {
    color: $success;
    margin: 0 0 1 0;
}

.bkx-tips-widget .tip-item {
    height: auto;
    margin: 0 0 1 0;
}

.bkx-tips-widget .tip-icon {
    width: 3;
}

.bkx-tips-widget .tip-text {
    width: 1fr;
}

/* ==========================================================================
   Keyboard Hints (for buttons, inputs, etc.)
   ========================================================================== */

.bkx-key-hint {
    color: $text-muted;
}

.bkx-key-hint kbd {
    background: $surface-darken-2;
    padding: 0 1;
    color: $text;
}

/* ==========================================================================
   Accessibility Focus Styles
   ========================================================================== */

/* Visible focus indicator */
*:focus {
    outline: solid $accent;
}

/* Focus within containers */
.bkx-focus-within *:focus-within {
    outline: solid $accent;
}

/* High contrast focus for important elements */
button:focus,
Input:focus,
Select:focus {
    outline: solid $accent;
}

