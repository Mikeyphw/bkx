/* ArchiveListPane styles (mikomn available) */

.bkx-archive-list-pane {
    width: 50;
    dock: left;
    background: $surface;
    border: solid $secondary;
}

.bkx-archive-list-pane > .label {
    height: 3;
    background: $primary;
    color: $foreground;
    content-align: center middle;
    dock: top;
}

.bkx-archive-list-pane > .filter {
    height: 3;
    dock: top;
    background: $surface-darken-1;
}

.bkx-archive-list-pane > .list {
    height: 1fr;
    dock: bottom;
}

.bkx-archive-list-pane > .count-label {
    height: 2;
    dock: bottom;
    background: $surface-darken-1;
    color: $foreground-muted;
    content-align: center middle;
}

/* Fallback styles without mikomn */

.header {
    height: 3;
    background: $primary;
    color: $foreground;
    content-align: center middle;
}

.filter-input {
    height: 3;
    dock: top;
    background: $surface-darken-1;
}

.archive-list {
    height: 1fr;
    dock: bottom;
}

.count-label {
    height: 2;
    dock: bottom;
    background: $surface-darken-1;
    color: $foreground-muted;
    content-align: center middle;
}

.bkx-archive-list-pane ListItem {
    height: 2;
    padding: 0 1;
}

.bkx-archive-list-pane ListItem:hover {
    background: $accent;
}

.bkx-archive-list-pane ListItem:focus {
    background: $primary;
}


.archive-name {
    color: $foreground;
    text-style: bold;
}

.archive-meta {
    color: $foreground-muted;
}

