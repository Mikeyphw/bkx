/* src/bkx/tui/css/panes/context_switcher.tcss */
/* Step 10C: Context Switcher Styling */

.bkx-context-switcher {
    width: 100%;
    height: auto;
    border-bottom: solid $border;
    background: $surface-darken-1;
}

.bkx-context-switcher .context-switcher-bar {
    height: auto;
    padding: 1;
}

.bkx-context-switcher .context-item {
    height: auto;
    margin-right: 2;
}

.bkx-context-switcher .context-icon {
    width: 3;
    content-align: center middle;
    margin-right: 1;
}

.bkx-context-switcher .context-select {
    width: 15;
}

.bkx-context-switcher .context-value {
    width: 20;
    color: $text;
}

.bkx-context-switcher .context-btn {
    width: 3;
    min-width: 3;
    margin-left: 1;
}

.bkx-context-switcher .context-btn.small {
    padding: 0 1;
}

.bkx-context-switcher .context-actions {
    margin-left: 1;
}

/* Compact context bar */
.bkx-context-bar-compact {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: $surface-darken-1;
}

.bkx-context-bar-compact .context-bar-text {
    color: $text-muted;
}

