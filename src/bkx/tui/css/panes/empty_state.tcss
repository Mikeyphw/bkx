/* EmptyStatePane styles */

.bkx-empty-state-pane {
    width: 60;
    height: 20;
    align: center middle;
    background: $surface;
    border: dashed $foreground-muted;
}

.empty-icon {
    height: 6;
    content-align: center middle;
}

.empty-title {
    height: 3;
    color: $foreground;
    text-style: bold;
    content-align: center middle;
}

.empty-message {
    height: auto;
    color: $foreground-muted;
    content-align: center middle;
    max-width: 50;
}

.empty-action {
    height: 5;
    dock: bottom;
    align: center middle;
}

