/* bkx/tui/css/panes/error_boundary.tcss */

/* ==========================================================================
   Error Boundary - Step 8C
   ========================================================================== */

.bkx-error-boundary {
    height: 100%;
    width: 100%;
}

.bkx-error-boundary .error-container {
    height: 100%;
    width: 100%;
    padding: 2;
    background: $error-background;
    border: solid $error;
}

.bkx-error-boundary .error-title {
    content-align: left;
    margin-bottom: 1;
    color: $error;
}

.bkx-error-boundary .error-message {
    content-align: left;
    margin-bottom: 1;
    color: $text;
}

.bkx-error-boundary .error-details {
    content-align: left;
    margin-bottom: 2;
    color: $text-muted;
}

.bkx-error-boundary .error-actions {
    height: auto;
}

.bkx-error-boundary .error-btn {
    width: auto;
    min-width: 10;
    padding: 0 2;
}

.bkx-error-boundary .error-btn.retry {
    border: solid $success;
    color: $success;
}

.bkx-error-boundary .error-btn.retry:hover {
    background: $success;
    color: $text;
}

.bkx-error-boundary .error-btn.dismiss {
    border: solid $warning;
    color: $warning;
}

.bkx-error-boundary .error-btn.dismiss:hover {
    background: $warning;
    color: $text;
}

/* ==========================================================================
   Dark theme adjustments
   ========================================================================== */

[data-theme="dark"] .bkx-error-boundary .error-container {
    background: $error-darken-3;
    border-color: $error-darken-1;
}

/* ==========================================================================
   Compact mode adjustments
   ========================================================================== */

.bkx-error-boundary.-compact {
    min-height: 5;
}

.bkx-error-boundary.-compact .error-container {
    padding: 1;
}

.bkx-error-boundary.-compact .error-details {
    display: none;
}

