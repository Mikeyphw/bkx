/* RunLogPane styles */

.bkx-run-log-pane {
    height: 15;
    dock: bottom;
    background: $surface;
    border: solid $secondary;
}

.bkx-run-log-pane RichLog {
    height: 1fr;
    dock: bottom;
}

.log-header {
    height: 2;
    dock: top;
    background: $surface-darken-1;
}


.log-title {
    color: $foreground;
    text-style: bold;
    padding: 0 1;
}


.log-controls {
    height: 2;
    dock: top;
    background: $surface-darken-1;
}

.log-controls Button {
    margin: 0 1;
    min-width: 8;
}

