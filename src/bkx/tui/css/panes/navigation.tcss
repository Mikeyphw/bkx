/* NavigationPane styles */

.bkx-navigation-pane {
    width: 25;
    dock: left;
    background: $surface;
    border: solid $primary;
}

.bkx-navigation-pane NavListItem {
    height: 1;
    padding: 0 1;
}

.bkx-navigation-pane NavListItem:hover {
    background: $accent;
}

.bkx-navigation-pane NavListItem:focus {
    background: $primary;
}

.nav-header {
    height: 3;
    padding: 1;
    background: $primary;
    color: $foreground;
    text-align: center;
    dock: top;
}


.nav-title {
    text-align: center;
    text-style: bold;
}

.nav-subtitle {
    text-align: center;
    color: $foreground-muted;
}

