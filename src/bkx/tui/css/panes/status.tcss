/* StatusFooterPane styles */

.bkx-status-footer-pane {
    height: 2;
    dock: bottom;
    background: $surface;
    color: $foreground-muted;
}

.status-section {
    width: 1fr;
    padding: 0 1;
    align: center middle;
}

.status-left {
    align: left middle;
}

.status-center {
    align: center middle;
}

.status-right {
    align: right middle;
}

.status-indicator {
    color: $success;
}


.status-indicator.busy {
    color: $warning;
}



.key-hint {
    color: $accent;
    text-style: bold;
}




.key-separator {
    color: $foreground-muted;
    margin: 0 1;
}



