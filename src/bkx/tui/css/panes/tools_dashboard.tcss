/* ToolsDashboardPane styles */

.bkx-tools-dashboard-pane {
    background: $background;
}

.dashboard-header {
    height: 3;
    dock: top;
    background: $primary;
    color: $foreground;
    content-align: center middle;
}

.dashboard-content {
    width: 1fr;
    height: 1fr;
    dock: bottom;
}

.dashboard-row {
    height: auto;
    width: 1fr;
    dock: top;
}

