/* TransferProgressPane styles */

TransferProgressPane {
    height: 10;
    dock: bottom;
    background: $surface;
    border: solid $accent;
}

.transfer-header {
    height: 3;
    background: $primary;
    color: $foreground;
    content-align: center middle;
}

.transfer-file {
    height: 2;
    dock: top;
    color: $foreground;
    padding: 0 1;
}

.transfer-bar {
    height: 4;
    dock: top;
    background: $surface-darken-2;
}

.transfer-fill {
    height: 100%;
    background: $accent;
    width: 0%;
}

.transfer-stats {
    height: 2;
    dock: bottom;
    background: $surface-darken-1;
    color: $foreground-muted;
}

.stat-label {
    color: $foreground-muted;
}

.stat-value {
    color: $foreground;
}

