
.bkx-shell-layout {
    height: 100%;
    width: 100%;
}

.bkx-shell {
    height: 100%;
    width: 100%;
}

.bkx-shell-panes {
    height: 100%;
    width: 100%;
}

/* Sidebar region */
.bkx-sidebar-region {
    min-width: 18;
    max-width: 30;
    width: auto;
}

/* Content region - takes remaining space */
.bkx-content-region {
    width: 1fr;
    height: 100%;
}

/* Content switcher */
.bkx-switcher {
    width: 1fr;
    height: 100%;
}

/* Run panel region */
.bkx-run-panel-region {
    min-width: 32;
    max-width: 52;
    width: auto;
    height: 100%;
}

.bkx-run-panel {
    height: 100%;
    width: 1fr;
}

/* Page containers */
.bkx-page {
    padding: 1 2;
    height: 100%;
    width: 100%;
}

/* Typography */
.page-title {
    text-style: bold;
    margin: 0 0 1 0;
}

.section-title {
    text-style: bold;
    margin: 1 0 1 0;
}

.muted {
    opacity: 70%;
    margin: 1 0 0 0;
}

/* Form layout */
.form-container {
    width: 1fr;
    height: 1fr;
    margin: 0 0 1 0;
}

.form-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.form-label {
    width: 16;
    content-align: right middle;
    padding: 0 1 0 0;
}

.form-input {
    width: 1fr;
}

.button-row {
    layout: horizontal;
    height: auto;
    margin: 1 0 0 0;
}

/* Destination picker modal: ensure path input has usable width */
.destination-picker {
    width: 86%;
    max-width: 120;
    height: auto;
    padding: 1 2;
}

.destination-picker .form-row,
.destination-picker .button-row {
    width: 1fr;
}

.destination-picker .form-input {
    min-width: 40;
}

.compact .destination-picker {
    width: 98%;
}

/* Archive split layout */
.archive-split {
    layout: horizontal;
    height: 1fr;
}

.archive-list {
    width: 1fr;
    height: 1fr;
    margin: 0 1 0 0;
}

.archive-create {
    width: 1fr;
    height: 1fr;
}

/* Responsive rules */
.expanded .bkx-footer {
    display: none;
}

.compact .bkx-sidebar-region {
    display: none;
}

.compact .bkx-run-panel-region {
    min-width: 1;
}

.compact .archive-split {
    layout: vertical;
}

/* Form fields */
.form-field {
    width: 1fr;
}

.form-field-wrapper {
    width: 1fr;
    height: 1fr;
}

.form-error {
    height: auto;
}

.sources-block {
    width: 1fr;
    height: 1fr;
}

.sources-header {
    height: auto;
}

.sources-list {
    height: 1fr;
}

/* Step 6B: crash screen */
.bkx-crash {
    padding: 1 2;
}
.bkx-crash-title {
    text-style: bold;
    margin: 0 0 1 0;
}
.bkx-crash-traceback {
    height: 1fr;
    border: round $primary;
    padding: 1;
}
.bkx-crash-actions {
    height: auto;
    margin: 1 0 0 0;
}

/* Mikomn sidebar widget overrides for proper height distribution */
.sb-root {
    height: 100%;
    width: 100%;
}

.sb-list {
    height: 100%;
    width: 100%;
}

.sb-list ListView {
    height: 100%;
    width: 100%;
}

.sb-list ListItem {
    height: auto;
}

.sb-row {
    height: auto;
}

.sb-item {
    height: auto;
}

.sb-header {
    height: auto;
}

.sb-hint {
    height: auto;
}

/* Footer region fixes */
.bkx-footer {
    height: auto;
    min-height: 1;
}

.bkx-footer-tabs {
    height: auto;
}

.bkx-footer-tabs .footer-tab {
    height: auto;
    min-height: 1;
}

/* Run panel content fix */
.bkx-run-content {
    height: 1fr;
}

.bkx-run-content ListView {
    height: 1fr;
}

.bkx-run-content ListItem {
    height: auto;
}
