/* App - toasts etc (Step 8) */

.rcm Toast {
    background: $surface;
    border: solid $border_subtle;
    padding: 1;
    margin: 0 1;
}

.rcm Toast.toast-success {
    border: solid $success;
}

.rcm Toast.toast-warning {
    border: solid $warning;
}

.rcm Toast.toast-error {
    border: solid $error;
}
