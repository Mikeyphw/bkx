/* Footer - overrides mikomn AppFooter (Step 8) */

.rcm AppFooter.app-footer {
    height: auto;
    min-height: 3;
    padding: 0 1;
    background: $surface;
}

.rcm .app-footer.two-line {
    layout: vertical;
}

.rcm .footer-shell .footer-tabs-row {
    width: auto;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.rcm .footer-shell .footer-hints-row {
    width: 1fr;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.rcm .footer-shell .footer-page {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    color: $muted;
    overflow: hidden;
}

.rcm .footer-shell .footer-hints {
    padding: 0 1;
    overflow: hidden;
}

.rcm .footer-shell .footer-hints-right {
    width: 1fr;
    min-width: 0;
    height: 1;
    align: right middle;
}

.rcm Button.footer-tab {
    height: 1;
    min-height: 1;
    min-width: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $muted;
}

.rcm Button.footer-tab:hover {
    color: $fg;
    background: $accent_primary;
}

.rcm Button.footer-tab.state-active {
    background: $accent_primary;
    color: $bg;
    text-style: bold;
}

.rcm Button.footer-tab:focus {
    border: none;
    background: $accent_primary;
    color: $bg;
}
