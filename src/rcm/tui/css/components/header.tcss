/* Header - overrides mikomn AppHeader (Step 8) */

.rcm AppHeader.app-header {
    height: auto;
    min-height: 1;
    max-height: 2;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $accent_primary;
}

.rcm .header-stack {
    width: 100%;
    height: auto;
}

.rcm .header-line1 {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
}

.rcm .header-line2 {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
}

.rcm .header-left {
    width: auto;
    min-width: 6;
    height: 1;
    layout: horizontal;
    align: left middle;
    overflow: hidden;
}

.rcm .header-center {
    width: 1fr;
    min-width: 0;
    height: 1;
    layout: horizontal;
    align: left middle;
    overflow: hidden;
}

.rcm .header-right {
    width: auto;
    height: 1;
    layout: horizontal;
    align: right middle;
}

.rcm .app-title,
.rcm .header-title {
    width: auto;
    height: 1;
    text-style: bold;
    color: $fg;
    overflow: hidden;
}

.rcm .header-subtitle {
    display: none;
}

.rcm .header-status {
    color: $muted;
    padding: 0 1;
    overflow: hidden;
}

.rcm .header-icon {
    padding: 0 1;
}

.rcm .header-icon:hover {
    background: $accent_muted;
}

.rcm .header-icon-primary {
    color: $accent_primary;
}

.rcm .header-icon-muted {
    color: $muted;
}

.rcm .header-icon-success {
    color: $success;
}

.rcm .header-icon-warning {
    color: $warning;
}

.rcm .header-icon-error {
    color: $error;
}

.rcm .header-save-status {
    padding: 0 1;
    text-style: bold;
}

.rcm .save-saved {
    color: $success;
}

.rcm .save-dirty {
    color: $warning;
}
