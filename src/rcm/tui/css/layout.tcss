/* Layout - subtle shell framing (Step 8) */

.rcm .header-body-footer-layout .layout-header {
    background: $surface;
    border-bottom: solid $accent_primary;
    height: auto;
}

.rcm .header-body-footer-layout .layout-footer {
    background: $surface;
    border-top: solid $accent_primary;
    height: auto;
}

.rcm .header-body-footer-layout .layout-body {
    background: $bg;
    height: 1fr;
    width: 1fr;
}
