"""Tests for Step 11 - Polish & Parity

Tests cover:
- 11A: TCSS Theme Tuning
- 11B: Animations & Transitions
- 11C: Accessibility
- 11D: Documentation/Help
"""

from __future__ import annotations

from pathlib import Path
from unittest.mock import Mock, patch
import pytest
import os


def get_tui_css_dir():
    """Get the path to the TUI CSS directory."""
    # Navigate from tests/tui/ to src/bkx/tui/css/
    current = Path(__file__).parent
    # Go up to tests, then into src/bkx/tui/css
    return current.parent.parent / "src" / "bkx" / "tui" / "css"


def get_tui_css_path(filename: str) -> Path:
    """Get the path to a specific CSS file."""
    return get_tui_css_dir() / filename


class TestAnimationsStep11B:
    """Tests for animation classes (Step 11B)."""

    def test_animation_css_exists(self) -> None:
        """Test that animation CSS file exists."""
        css_path = get_tui_css_path("animations.tcss")
        assert css_path.exists(), f"animations.tcss not found at {css_path}"
        # Debug output
        if not css_path.exists():
            print(f"DEBUG: Looking for CSS at: {css_path}")
            print(f"DEBUG: TUI CSS dir exists: {css_path.parent.exists()}")
            if css_path.parent.exists():
                print(f"DEBUG: Files in dir: {list(css_path.parent.iterdir())}")

    def test_animation_classes_exist(self) -> None:
        """Test that animation classes are defined."""
        css_path = get_tui_css_path("animations.tcss")
        assert css_path.exists()

        content = css_path.read_text()

        # Check for key animation classes
        assert "bkx-animate-fade-in" in content
        assert "bkx-animate-pulse" in content
        assert "bkx-animate-spin" in content
        assert "bkx-transition-fast" in content
        assert "bkx-transition-normal" in content

    def test_keyframes_defined(self) -> None:
        """Test that CSS keyframes are defined."""
        css_path = get_tui_css_path("animations.tcss")
        content = css_path.read_text()

        # Check for keyframe definitions
        assert "@keyframes bkx-fade-in" in content
        assert "@keyframes bkx-pulse" in content
        assert "@keyframes bkx-spin" in content

    def test_reduced_motion_support(self) -> None:
        """Test reduced motion media query exists."""
        css_path = get_tui_css_path("animations.tcss")
        content = css_path.read_text()

        assert "@media (prefers-reduced-motion" in content
        assert "animation-duration: 0.01ms" in content


