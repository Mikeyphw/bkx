    def test_all_css_files_loaded(self) -> None:
        """Test that all Step 11 CSS files can be loaded."""
        css_dir = get_tui_css_dir()

        # Step 11 files
        step11_files = [
            "animations.tcss",
            "help.tcss",
            "accessibility.tcss",
        ]

        for filename in step11_files:
            path = css_dir / filename
            assert path.exists(), f"CSS file {filename} does not exist at {path}"
            content = path.read_text()
            assert len(content) > 0, f"CSS file {filename} is empty"

